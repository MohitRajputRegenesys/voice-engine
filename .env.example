# ── Voice Engine configuration ─────────────────────────────────────────────
# Copy this file to `.env`. ONE Deepgram key powers BOTH listening & speaking.

# ── Speech-to-Text (Deepgram realtime streaming) ────────────────────────────
DEEPGRAM_API_KEY=
STT_MODEL=nova-3          # nova-3 recommended -- nova-2 is rejected by Deepgram (HTTP 400)
STT_LANGUAGE=en           # language hint for Deepgram (blank = vendor default)
STT_SAMPLE_RATE=16000     # must match the PCM16 audio you stream over WS
STT_ENCODING=linear16     # linear16 for browser, mulaw for Twilio calls

# ── Text-to-Speech ──────────────────────────────────────────────────────────
# Selection order:
#   TTS_PROVIDER=deepgram  -> Deepgram Aura voices (uses DEEPGRAM_API_KEY)
#   TTS_PROVIDER=edge      -> free Microsoft Edge TTS (no key needed)
#   TTS_PROVIDER=""        -> auto: Aura when DEEPGRAM_API_KEY is set, else mock
TTS_PROVIDER=
TTS_MODEL=aura-2-thalia-en    # any Deepgram Aura voice id
TTS_VOICE=en-US-AriaNeural    # only used when TTS_PROVIDER=edge

# ── Optional brain adapter ("bring your own LLM backend") ───────────────────
# The RAG brain lives in the saleKnowledgeBase app backend. When unset (or when
# clients connect with ?auto_llm=0), the engine performs STT only and YOUR AI
# decides the answers, pushing text back over WebSocket:
#   {"type": "speak", "data": "<your answer>"}
FACILITATOR_API_URL=http://localhost:8000
FACILITATOR_API_PATH=/api/v1/rag/chat   # app backend RAG chat endpoint
FACILITATOR_TOP_K=5
FACILITATOR_ALPHA=0.5

# ── Twilio calling feature (phone calls via Twilio Media Streams) ────────────
# Enables the /media-stream WebSocket, /api/twilio/voice & /api/twilio/status
# webhooks, and the /api/calls/outbound trigger. Inbound/outbound → TwiML and
# the outbound REST call need real Twilio credentials.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=              # Twilio outbound caller-id
TWILIO_BASE_URL=your-public-host.ngrok-free.dev
# ^ MUST be the PUBLIC ngrok host Twilio can reach (bare host, no protocol).
#   Do NOT use localhost/127.0.0.1 — Twilio cannot reach a private/local URL
#   and returns error 11100 "Invalid URL". Create the tunnel to the voice
#   engine port:  ngrok http 8001
TWILIO_VOICE_URL=                 # optional: public TwiML URL if it differs
CALLS_API_KEY=secret-api-key      # X-API-Key required by /api/calls/outbound
ENV=development                   # "test" bypasses Twilio signature checks

# Twilio-call STT overrides (optional; defaults mirror the working reference
# calling agent: model nova-3, no language hint, mu-law 8 kHz).
# TWILIO_STT_MODEL=nova-3
# TWILIO_STT_LANGUAGE=en-US

# Hold music while the AI generates an answer (soft built-in pad by default).
TWILIO_HOLD_MUSIC=true
# TWILIO_HOLD_MUSIC_FILE=                      # raw mu-law 8kHz mono, or 16-bit 8kHz mono WAV
TWILIO_HOLD_MUSIC_GAIN=0.3                     # volume: 0.0 (silent) - 1.0
TWILIO_HOLD_MUSIC_DELAY_MS=400                 # wait this long before music starts

# Call tuning (optional)
TWILIO_WELCOME_GREETING=Hello! Welcome to our sales information service. How can I help you today?
TWILIO_PREBUFFER_MS=180
TWILIO_BARGE_IN_RMS_THRESHOLD=900.0
TWILIO_BARGE_IN_CONSECUTIVE_FRAMES=4
TWILIO_SILENCE_ENDPOINT_MS=800
TWILIO_UTTERANCE_END_MS=1500
