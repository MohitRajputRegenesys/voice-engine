# ── Voice Engine configuration ─────────────────────────────────────────────
# Copy this file to `.env` and fill in the values you want to enable.

# Real-time STT. Required for real speech-to-text (mock is used when absent).
DEEPGRAM_API_KEY=


# Point the voice pipeline's LLM at the AI Facilitator RAG backend
# (your `ai-facilitators` server on port 8000). When set, the facilitator's
# /api/chat is used as the brain instead of the mock LLM.
FACILITATOR_API_URL=http://localhost:8000
FACILITATOR_TOP_K=5
FACILITATOR_ALPHA=0.5

# Real TTS via Microsoft Edge TTS (free, no key). Set to "edge" to enable.
TTS_PROVIDER=
TTS_VOICE=en-US-AriaNeural
